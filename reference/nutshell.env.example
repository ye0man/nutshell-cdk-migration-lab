# Nutshell 0.22.0 operator environment (annotated)
# Use this as a checklist, not as a drop-in file.

MINT_LISTEN_HOST=127.0.0.1
MINT_LISTEN_PORT=3338
MINT_INFO_NAME="Example mint"
MINT_INFO_DESCRIPTION="Example description"
MINT_INFO_CONTACT=[["email","ops@example.com"]]
MINT_INFO_MOTD=""
MINT_INFO_URLS=["https://mint.example.com"]
MINT_INFO_TOS_URL="https://mint.example.com/tos"

# Seed: use exactly one of these, matching what the running mint actually uses.
# MINT_MNEMONIC="word word ... word"       # BIP-39, 0.22.x
# MINT_PRIVATE_KEY="legacy raw seed string" # 0.20.x / 0.21.x and earlier

MINT_DERIVATION_PATH="m/0'/0'/0'"
MINT_INPUT_FEE_PPK=100

# SQLite
MINT_DATABASE=data/mint
# or PostgreSQL
# MINT_DATABASE=postgres://nutshell:password@127.0.0.1:5432/nutshell

MINT_BACKEND_BOLT11_SAT=FakeWallet
# MINT_BACKEND_BOLT11_USD=FakeWallet
# MINT_BACKEND_BOLT11_EUR=FakeWallet

# Example LND RPC settings
# MINT_LND_RPC_ENDPOINT=127.0.0.1:10009
# MINT_LND_RPC_CERT=/path/to/tls.cert
# MINT_LND_RPC_MACAROON=/path/to/admin.macaroon

# Example CLN REST settings (CDK uses the gRPC socket instead)
# MINT_CLNREST_URL=https://127.0.0.1:3010
# MINT_CLNREST_CERT=/path/to/ca.pem
# MINT_CLNREST_RUNE=/path/to/rune

MINT_QUOTE_TTL=600
MELT_QUOTE_TTL=120
MINT_MAX_MINT_BOLT11_SAT=100000
MINT_MAX_MELT_BOLT11_SAT=100000
MINT_MAX_BALANCE=1000000
MINT_RATE_LIMIT=TRUE
MINT_GLOBAL_RATE_LIMIT_PER_MINUTE=60
MINT_TRANSACTION_RATE_LIMIT_PER_MINUTE=20

# NUT-21 auth (separate auth database; not migrated to CDK)
# MINT_REQUIRE_AUTH=TRUE
# MINT_AUTH_DATABASE=postgres://nutshell:password@127.0.0.1:5432/nutshell_auth
# MINT_AUTH_OICD_DISCOVERY_URL=...
# MINT_AUTH_OICD_CLIENT_ID=cashu-client

# NUT-19 cache (not migrated; safe to discard)
# MINT_REDIS_CACHE_ENABLED=TRUE
# MINT_REDIS_CACHE_URL=redis://127.0.0.1:6379
